# NetRadar Environment Configuration (Optional)
# No mandatory environment variables are required for standard local dev or Vercel deployment.

# Default DNS-over-HTTPS Resolver URL (Defaults to Cloudflare 1.1.1.1)
NEXT_PUBLIC_DEFAULT_DOH_RESOLVER=https://cloudflare-dns.com/dns-query

# Server-side Max Throughput Stream Size in MB (Default: 10 MB)
MAX_THROUGHPUT_STREAM_MB=10

# TCP Socket Diagnostic Timeout in Milliseconds (Default: 3500 ms)
TCP_SOCKET_TIMEOUT_MS=3500
